<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>test</RootNamespace>
        <SatelliteResourceLanguages>zh-CN</SatelliteResourceLanguages>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
        <PackageReference Include="log4net" Version="3.4.0" />
        <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.12" />
        <!-- LogRuntime.cs 依赖 Models（LogSection），Models 依赖 YamlDotNet；版本与主项目一致 -->
        <PackageReference Include="YamlDotNet" Version="18.1.0" />
    </ItemGroup>
    <ItemGroup>
        <!-- 独立 SMU 控制工具：直接编译所需源文件，不引用整个主项目 -->
        <Compile Include="..\JiaoLongControl\Server\Core\Controllers\RyzenSmuController.cs" Link="Core\RyzenSmuController.cs" />
        <!-- RyzenSmuController.cs 依赖 Core\Services\SmuWriteGate.cs（using JiaoLongControl.Server.Core.Services，
             RyzenSmuController.cs:4 与 :138 的 SmuWriteGate.TryValidate）—— 原先漏登记，探针工程编译失败 CS0234 -->
        <Compile Include="..\JiaoLongControl\Server\Core\Services\SmuWriteGate.cs" Link="Core\SmuWriteGate.cs" />
        <Compile Include="..\JiaoLongControl\Server\Core\Drivers\PawnIO.cs" Link="Core\PawnIO.cs" />
        <Compile Include="..\JiaoLongControl\Server\Core\Native\Kernel32.cs" Link="Core\Kernel32.cs" />
        <Compile Include="..\JiaoLongControl\Server\Core\Utils\CommandResult.cs" Link="Core\CommandResult.cs" />
        <!-- CommandResult.cs:36 引用 LogRuntime.VerboseCommandLog（HEAD 起就是这样），
             故 LogRuntime.cs 及其 Models 依赖（LogSection）同样必须登记，否则 CS0103 -->
        <Compile Include="..\JiaoLongControl\Server\Core\Utils\LogRuntime.cs" Link="Core\LogRuntime.cs" />
        <Compile Include="..\JiaoLongControl\Server\Core\Models\JiaoLongConfig.cs" Link="Core\JiaoLongConfig.cs" />
        <Compile Include="..\JiaoLongControl\Server\Core\Models\ConfigAttributes.cs" Link="Core\ConfigAttributes.cs" />
    </ItemGroup>
    <ItemGroup>
        <None Include="..\JiaoLongControl\Drivers\PawnIO\RyzenSMU.bin;..\JiaoLongControl\Drivers\PawnIO\AMDFamily17.bin" Link="Drivers\PawnIO\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>